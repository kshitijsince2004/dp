# Backend API origin (must match backend PORT, default 5000)
VITE_API_URL=http://localhost:5000/api

# Optional: enable client debug logging outside Vite DEV
# VITE_DEBUG_LOGGING=true

# Optional: allow DebugBar Err 400/401/403/500 buttons (disabled by default).
# Without this, any stuck prism_debug_api_mode=error_* is cleared on load.
# VITE_ENABLE_API_ERROR_SIMULATION=true
