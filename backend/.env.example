NODE_ENV=development
PORT=5000

# PostgreSQL — docker-compose maps host 5435 -> container 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/pharos_db

# RabbitMQ
RABBITMQ_URL=amqp://pharos:pharos123@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# JWT — kept for non-auth callers (e.g. logs best-effort decode). Auth sessions are SuperTokens.
JWT_SECRET=change_this_to_strong_random_string_access
JWT_REFRESH_SECRET=change_this_to_strong_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Startup auto-load (sync-config every boot; load-ref when sources change). Set false to disable.
STARTUP_AUTOLOAD=true

# File Storage (must match what reports controllers read)
REPORTS_DIR=./generated-reports

# CORS Frontend — set to the real SPA origin in production
FRONTEND_URL=http://localhost:5173

# SuperTokens (auth + RBAC). Core runs via docker-compose (service: supertokens).
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# Set only if the Core is started with API_KEYS (recommended in production):
SUPERTOKENS_API_KEY=
# Where the browser reaches this API, and the SPA origin (used by SuperTokens appInfo):
API_DOMAIN=http://localhost:5000
WEBSITE_DOMAIN=http://localhost:5173
