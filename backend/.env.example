NODE_ENV=development
PORT=5000

# PostgreSQL — docker-compose maps host 5435 -> container 5432
DATABASE_URL=postgresql://pharos:pharos@localhost:5435/pharos_db

# RabbitMQ
RABBITMQ_URL=amqp://pharos:pharos123@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# JWT — required in production (server refuses to boot without them when NODE_ENV=production)
JWT_SECRET=change_this_to_strong_random_string_access
JWT_REFRESH_SECRET=change_this_to_strong_random_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Startup auto-load (sync-config every boot; load-ref when sources change). Set false to disable.
STARTUP_AUTOLOAD=true

# File Storage (must match what reports controllers read)
REPORTS_DIR=./generated-reports

# CORS Frontend — set to the real SPA origin in production
FRONTEND_URL=http://localhost:5173
