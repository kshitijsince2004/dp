{
  "name": "backend",
  "version": "1.0.0",
  "description": " Backend API - Delhi Police Reporting Prototype",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node --max-old-space-size=2048 index.js",
    "db:migrate": "knex migrate:latest",
    "db:seed": "knex seed:run",
    "db:rollback": "knex migrate:rollback",
    "db:reset": "node scripts/dev/db-reset.mjs",
    "sync-config": "node scripts/sync-config.mjs",
    "load-ref": "node scripts/load-ref.mjs",
    "import:parity": "node scripts/import-bridge-parity.js",
    "import:corpus": "node scripts/import-reliability/replay-corpus.mjs",
    "audit:verify": "node scripts/verify-audit-chain.mjs",
    "seed:test-data": "node scripts/seed-test-data.js",
    "logs:clear": "node scripts/dev/clear-logs.mjs",
    "test": "node tests/verify_formulas.mjs && node tests/test_phq_comprehensive.mjs"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "CrimeDiaries": "file:..",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "i18n-nationality": "^1.4.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.5",
    "puppeteer": "^25.1.0",
    "slugify": "^1.6.9",
    "supertokens-node": "^20.1.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "axios": "^1.18.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
